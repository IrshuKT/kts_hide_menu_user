<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Add "Hidden Menus" tab to the user form -->
    <record id="view_users_form_hide_menu" model="ir.ui.view">
        <field name="name">res.users.form.hide.menu</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <notebook position="inside">
                <page string="Hidden Menus" name="hide_menus">
                    <group>
                        <div colspan="2" class="alert alert-info" role="alert" style="margin-bottom:10px;">
                            <strong>ℹ️ Note:</strong>
                            Menus added here will be <strong>hidden</strong> from this user.
                            Administrators always see all menus regardless of this setting.
                        </div>
                    </group>
                    <field name="hide_menu_ids"
                           widget="many2many_tags"
                           placeholder="Add menus to hide..."
                           domain="[('parent_id', '!=', False)]"
                           options="{'no_create': True, 'no_create_edit': True}">
                        <list string="Hidden Menus">
                            <field name="complete_name"/>
<!--                            <field name="action"/>-->
                        </list>
                    </field>
                    <p class="text-muted" style="margin-top:8px;">
                        <i>Changes take effect on next login or page refresh by the user.</i>
                    </p>
                </page>
            </notebook>
        </field>
    </record>

</odoo>
