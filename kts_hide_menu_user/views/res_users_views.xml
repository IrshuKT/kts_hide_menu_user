<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_users_form_menu_profile" model="ir.ui.view">
        <field name="name">res.users.form.menu.profile</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <notebook position="inside">
                <page string="Menu Access" name="menu_access">
                    <group string="Profile Based (Recommended)">
                        <field name="menu_profile_id"
                               placeholder="Assign a menu profile..."/>
                    </group>
                    <group string="Manual Hidden Menus (Advanced)">
                        <field name="hide_menu_ids"
                               widget="many2many_tags"
                               placeholder="Add menus to hide..."
                               options="{'no_create': True, 'no_create_edit': True}">
                            <list>
                                <field name="name"/>
                            </list>
                        </field>
                    </group>
                </page>
            </notebook>
        </field>
    </record>
</odoo>